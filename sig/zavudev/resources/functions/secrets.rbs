module Zavudev
  module Resources
    class Functions
      class Secrets
        def list: (
          String function_id,
          ?request_options: Zavudev::request_opts
        ) -> Zavudev::Models::Functions::SecretListResponse

        def set: (
          String key,
          function_id: String,
          value: String,
          ?request_options: Zavudev::request_opts
        ) -> top

        def unset: (
          String key,
          function_id: String,
          ?request_options: Zavudev::request_opts
        ) -> nil

        def initialize: (client: Zavudev::Client) -> void
      end
    end
  end
end
