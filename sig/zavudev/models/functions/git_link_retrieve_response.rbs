          attr_accessor last_deploy_at: Time?

          attr_accessor last_error: String?

          attr_accessor last_status: Zavudev::Models::Functions::GitLinkRetrieveResponse::Link::last_status?

          attr_accessor root_dir: String?

          def initialize: (
