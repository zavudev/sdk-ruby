          }

          type connection = :app | :manual

          module Connection
            extend Zavudev::Internal::Type::Enum

            APP: :app
            MANUAL: :manual

            def self?.values: -> ::Array[Zavudev::Models::Functions::GitLinkRetrieveResponse::Link::connection]
