      attr_accessor project: Zavudev::Models::MeRetrieveResponse::Project

      attr_accessor team: Zavudev::Models::MeRetrieveResponse::Team

      def initialize: (
        api_key: Zavudev::Models::MeRetrieveResponse::APIKey,
