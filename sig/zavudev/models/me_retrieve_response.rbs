        is_test_mode: bool,
        project: Zavudev::Models::MeRetrieveResponse::Project,
        team: Zavudev::Models::MeRetrieveResponse::Team
      }

      type api_key = { id: String }

      class APIKey < Zavudev::Internal::Type::BaseModel
        attr_accessor id: String

