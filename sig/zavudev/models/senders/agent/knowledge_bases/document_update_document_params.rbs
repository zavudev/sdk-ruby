            attr_reader content: String?

            def content=: (String) -> String

            attr_reader title: String?

            def title=: (String) -> String

            def initialize: (
              sender_id: String,
              kb_id: String,
              doc_id: String,
              ?content: String,
              ?title: String,
              ?request_options: Zavudev::request_opts
            ) -> void

            def to_hash: -> {
