module Zavudev
  module Models
    type phone_number_status =
      :active | :suspended | :pending | :releasing | :released

    module PhoneNumberStatus
      extend Zavudev::Internal::Type::Enum

      ACTIVE: :active
      SUSPENDED: :suspended
      PENDING: :pending
      RELEASING: :releasing
      RELEASED: :released

      def self?.values: -> ::Array[Zavudev::Models::phone_number_status]
    end
  end
end
